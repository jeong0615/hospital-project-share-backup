server {
      listen 80;
      server_name hospital-
      web.pp.ua;

      location = /emr {
          return 301 /emr/;
      }

      location ^~ /emr/ {
          proxy_pass
          http://IP_REDACTED:3000/;
          proxy_http_version 1.1;
          proxy_set_header Upgrade
          $http_upgrade;
          proxy_set_header
          Connection 'upgrade';
          proxy_set_header Host
          $host;
      }

      location / {
          proxy_pass
          http://IP_REDACTED:3000;
          proxy_http_version 1.1;
          proxy_set_header Upgrade
          $http_upgrade;
          proxy_set_header
          Connection 'upgrade';
          proxy_set_header Host
          $host;
      }
  }
