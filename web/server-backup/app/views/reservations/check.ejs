<%- include('../partials/header') %>

<div class="form-page">
  <h1>예약확인 / 취소</h1>
  <p class="muted">예약번호와 비밀번호가 일치할 때만 글을 확인할 수 있습니다.</p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert success"><%= success %></div>
  <% } %>

  <form class="form-card compact" method="post" action="/reservations/check">
    <label>예약번호<input type="number" name="reservation_id" required></label>
    <label>비밀번호<input type="password" name="access_password" required></label>
    <button class="solid-btn" type="submit">확인</button>
  </form>

  <% if (post) { %>
    <div class="content-card" style="margin-top:24px;">
      <h2><%= post.title %></h2>
      <table>
        <tr><th>예약번호</th><td><%= post.reservation_id %></td></tr>
        <tr><th>환자명</th><td><%= post.patient_name %></td></tr>
        <tr><th>연락처</th><td><%= post.phone %></td></tr>
        <tr><th>진료과</th><td><%= post.department %></td></tr>
        <tr><th>등록일</th><td><%= post.created_at %></td></tr>
        <tr><th>내용</th><td><div class="reservation-body"><%= post.content %></div></td></tr>
      </table>
    </div>

    <form method="POST" action="/reservations/delete">
      <input type="hidden" name="reservation_id" value="<%= post.reservation_id %>">
      <label>비밀번호 확인</label>
      <input type="password" name="access_password" required>
      <button class="solid-btn danger-btn" type="submit">예약 취소</button>
    </form>
  <% } %>

  <hr>

  <h2>예약 목록</h2>

<% if (typeof reservations !== 'undefined' && reservations.length > 0) { %>
    <table border="1" style="width:100%; text-align:center;">
      <tr>
        <th>번호</th>
        <th>환자명</th>
        <th>진료과</th>
        <th>등록일</th>
      </tr>

      <% reservations.forEach(function(r) { %>
        <tr>
          <td><%= r.reservation_id %></td>
          <td><%= r.patient_name %></td>
          <td><%= r.department %></td>
          <td><%= r.created_at %></td>
        </tr>
      <% }) %>
    </table>
  <% } else { %>
    <p>예약 내역이 없습니다.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>