{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HospitalDRReadCloudflareTokenParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": "AWS_ARN_REDACTED"
    },
    {
      "Sid": "HospitalDRDecryptSsmSecureStringOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "000000000000",
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        }
      }
    }
  ]
}
