[Unit]
Description=Hospital DR ChatOps approval service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloud
WorkingDirectory=/home/cloud/dr_project
Environment=DR_SECRET_FILE=/home/cloud/hospital-dr-secrets/dr.env
Environment=DR_STATE_DIR=/var/lib/hospital-dr
Environment=DR_REPO_ROOT=/home/cloud/hospital-dr-repo
Environment=DR_SCRIPT_ROOT=/home/cloud/hospital-dr-repo/infra/terraform
Environment=DR_TERRAFORM_DIR=/home/cloud/hospital-dr-terraform
Environment=DR_ANSIBLE_DIR=/home/cloud/hospital-dr-ansible
Environment=DR_LOG_DIR=/home/cloud/hospital-dr-terraform
StateDirectory=hospital-dr
StateDirectoryMode=0750
Environment=CHATOPS_STATE_DB=/var/lib/hospital-dr/chatops_state.sqlite3
Environment=CHATOPS_EXECUTION_LOCK_FILE=/var/lib/hospital-dr/chatops.pipeline.lock
ExecStart=/usr/bin/python3 /home/cloud/dr_project/app.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
