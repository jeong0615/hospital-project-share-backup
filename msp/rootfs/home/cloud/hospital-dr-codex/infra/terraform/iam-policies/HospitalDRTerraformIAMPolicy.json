{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HospitalDRTerraformIdentityRead",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "HospitalDRManageCostGuardRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "AWS_ARN_REDACTED"
    },
    {
      "Sid": "HospitalDRPassOnlyCostGuardRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "AWS_ARN_REDACTED",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
