# Safe defaults: no Web NAT role is enabled and the normal NAT mode remains the
# source-compatible default. This file never authorizes a NAT Gateway create.
AWS_WEB_NAT_INSTANCE_ENABLED=false
TF_VAR_aws_web_nat_instance_enabled=false
TF_VAR_private_egress_mode=nat_gateway
TF_VAR_enable_nat_gateway=false

# Existing NAT Gateway migration (only if a retained NAT Gateway is verified
# available):
# TF_VAR_enable_nat_gateway=true
# AWS_WEB_NAT_INSTANCE_ENABLED=true
# TF_VAR_aws_web_nat_instance_enabled=true
# TF_VAR_private_egress_mode=web_nat_instance

# BLACKHOLE recovery (current design; never creates/recreates a NAT Gateway):
# AWS_WEB_NAT_INSTANCE_ENABLED=true
# TF_VAR_aws_web_nat_instance_enabled=true
# TF_VAR_private_egress_mode=web_nat_instance
# TF_VAR_enable_nat_gateway=false
