# Copy to the external secret file configured by DR_SECRET_FILE.
# Configure each Slack App's Interactivity Request URL separately:
# Failover: /slack/failover/action
# Failback: /slack/failback/action
SLACK_CHANNEL_ID=
# Private Emergency DR Console channel.  The channel itself and membership
# are created/configured in Slack; this value is only its ID.
SLACK_EMERGENCY_CHANNEL_ID=
# Dedicated Emergency App credentials.  Never fall back to Failover credentials.
SLACK_EMERGENCY_BOT_TOKEN=
SLACK_EMERGENCY_SIGNING_SECRET=
# Optional Alert-only Bot; never reuse the Failover/Failback control tokens here.
SLACK_ALERT_CHANNEL_ID=
SLACK_ALERT_BOT_TOKEN=
# Optional dedicated security channel.  Do not reuse the DR approval or
# general alert token/channel; correlated HIGH incidents are sent here only.
WAZUH_SECURITY_SLACK_ENABLED=false
WAZUH_SECURITY_SLACK_DRY_RUN=false
WAZUH_SECURITY_SLACK_CHANNEL=
WAZUH_SECURITY_SLACK_TOKEN=
SLACK_SECURITY_CHANNEL_ID=
SLACK_SECURITY_BOT_TOKEN=
SLACK_FAILOVER_BOT_TOKEN=
SLACK_FAILOVER_SIGNING_SECRET=
SLACK_FAILBACK_BOT_TOKEN=
SLACK_FAILBACK_SIGNING_SECRET=
SLACK_ADMIN_USER_IDS=U_ADMIN_1,U_ADMIN_2
# Production quorum is always two by default. For a short live test only,
# set DR_APPROVAL_REQUIRED=1 and an offset-qualified ISO-8601 expiry no more
# than four hours ahead; the request snapshots the quorum and expires with it.
DR_APPROVAL_REQUIRED=2
DR_SINGLE_APPROVAL_TEST_EXPIRES_AT=
# Emergency requests expire after 15 minutes and still require two admins.
EMERGENCY_TTL_SECONDS=900
# Complete encrypted dump pairs are discovered read-only from this directory.
DUMP_BACKUP_DIR=/home/cloud/db_backups
# Global execution remains disabled by default. A request-specific overwrite
# grant is persisted by ChatOps in the protected approval SQLite row after the
# exact backup/hash/target are shown to two distinct administrators.
DUMP_RESTORE_EXEC_ENABLED=false
DUMP_RESTORE_EXECUTOR=
# App service DB endpoint is independent of the dr-db SSH/Ansible alias.
# Keep the existing AWS DR DB as default. An isolated target requires its
# explicit instance ID/IP/port and read-only AWS identity validation first.
DR_DB_SERVICE_MODE=existing
DR_DB_SERVICE_HOST=IP_REDACTED
DR_DB_SERVICE_PORT=3306
DR_DB_SERVICE_INSTANCE_ID=
WAZUH_FAILBACK_REQUIRED_AGENTS=DB_Server,Web_Server,EMR_Server
WAZUH_API_URL=https://IP_REDACTED:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=https://IP_REDACTED:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_CA_CERT=/etc/hospital-dr/wazuh/root-ca.pem
WAZUH_SECURITY_LOOKBACK_MINUTES=15
WAZUH_CORRELATION_STATE_FILE=/var/lib/hospital-dr/wazuh_correlation.json
WAZUH_CORRELATION_WINDOW_SECONDS=900
CHATOPS_STATE_DB=/var/lib/hospital-dr/chatops_state.sqlite3
# Per-request sanitized execution logs; the Slack "실행 로그 확인" action reads only a bounded tail.
CHATOPS_EXECUTION_LOG_DIR=/var/lib/hospital-dr/execution-logs
# Workflow scripts' shared operational log directory; Slack request-log views do not read from it.
DR_LOG_DIR=/home/cloud/hospital-dr-terraform
CHATOPS_SLACK_CLEANUP_TTL_SECONDS=86400
CHATOPS_SLACK_CLEANUP_INTERVAL_SECONDS=300
# The existing cleanup worker checks the Emergency Console every 60 seconds.
EMERGENCY_CONSOLE_WATCHDOG_INTERVAL_SECONDS=60
# Defaults to <state DB directory>/audit/chatops_audit.jsonl when omitted.
CHATOPS_AUDIT_FILE=
# Structured, atomic RTO timeline state; keep this outside Git.
DR_RTO_TIMELINE_FILE=/var/lib/hospital-dr/rto_timeline.json
# Presentation-only evidence bundles are written per RUN_ID outside Git.
DR_EVIDENCE_ROOT=/var/lib/hospital-dr/evidence
# Optional JSONL timing source; records are used only when run_id correlation is present.
DR_TIMING_FILE=/var/lib/hospital-dr/dr_timing.jsonl
CHATOPS_REQUEST_URL=http://IP_REDACTED:5000/chatops/request
# Explicit Zabbix broad approval-path test. The API helper keeps the live
# action disabled until `configure_broad_test_mode.py --enable` is run.
ZABBIX_DR_BROAD_TEST_MODE=false
ZABBIX_DR_TEST_HOSTS=web_server,DB_Server,Doc_Server,Zabbix server
ZABBIX_TEST_MODE_MAX_EVENT_AGE_SECONDS=3600
# Production DR approval media reject delayed/stale Zabbix events.  This
# applies only to the approval scripts; normal Alert media is unaffected.
ZABBIX_DR_MAX_EVENT_AGE_SECONDS=86400
# Must be a high-entropy shared key (at least 32 bytes) configured outside Git
# in both this ChatOps secret file and the Zabbix alert-script environment.
# Only signed Cloud_Slack_DR_Trigger calls may create production Zabbix
# Failover candidates; never put the key in Zabbix action text or arguments.
ZABBIX_PRODUCTION_ACTION_HMAC_KEY=
# Demo Freeze uses manual Failback requests; set true only to restore the
# legacy Zabbix Recovery-to-Failback action.
ZABBIX_AUTO_FAILBACK_ENABLED=false
# Legacy recovery-window settings are retained for compatibility only.  The
# Demo Freeze Failback candidate is immediate and does not use this guard.
FAILBACK_STABILITY_GUARD_ENABLED=false
FAILBACK_STABILITY_SECONDS=0
FAILBACK_STABILITY_CHECK_INTERVAL_SECONDS=2
FAILBACK_GUARD_SCRIPT=/usr/lib/zabbix/alertscripts/zabbix_failback_guard.sh
# Broad test media stays independently controllable; set true only when the
# test environment also supplies the three recovery probe endpoints.
FAILBACK_GUARD_APPLY_TO_TEST_MEDIA=false
# Failback additionally requires the four existing Zabbix SNMP availability
# items to be READY and fresh.  The provider uses the existing Zabbix API
# identity; it never polls physical devices directly.
NETWORK_DR_HEALTH_ENABLED=true
NETWORK_DR_HEALTH_REQUIRED_HOSTS=Cisco-2800-Series,Catalyst-2950-Series,Catalyst-3560-Series,Catalyst-3550-Series
NETWORK_DR_HEALTH_ITEM_NAME=Cisco IOS: SNMP agent availability
NETWORK_DR_HEALTH_ITEM_KEY=
NETWORK_DR_HEALTH_FRESHNESS_SECONDS=300
# Optional path to an existing external Zabbix API env file.  Do not copy its
# values into Git or into a second plaintext secret file.
NETWORK_DR_HEALTH_ZABBIX_ENV_FILE=
NETWORK_DR_HEALTH_ZABBIX_API_URL=
NETWORK_DR_HEALTH_ZABBIX_API_TOKEN=
NETWORK_DR_HEALTH_ZABBIX_API_USER=
NETWORK_DR_HEALTH_ZABBIX_API_PASSWORD=
# Required for the production recovery stability guard.  Do not use a
# documentation/example address; failback stays blocked until these are set.
ONPREM_WEB_HEALTH_URL=
ONPREM_DOC_HEALTH_URL=
# Existing NR (CDC) source-coordinate inspection only. The dedicated key must
# be provisioned/authorized out of band; never use a password or disable
# host-key verification. This is not a general Failover execution gate.
ONPREM_SSH_KEY=
ONPREM_SSH_KNOWN_HOSTS_FILE=/home/cloud/.ssh/known_hosts
ONPREM_DB_HOST=IP_REDACTED
ONPREM_DB_PORT=3306
ONPREM_DB_SERVER_UUID_EXPECTED=d4ea304e-269f-11f1-b866-08002794ce78
CF_TOKEN_PARAM_NAME=/hospital-dr/cloudflare/api-token
CF_TOKEN_AWS_REGION=ap-northeast-2
# Non-secret Cloudflare zone metadata used by DNS transactions and status checks.
CF_ZONE_ID=
# Controller-side production Origin CA sources; never store the private key in Git.
DR_TLS_CERT_FILE=/home/cloud/hospital-dr-secrets/tls/hospital-web.crt
DR_TLS_KEY_FILE=/home/cloud/hospital-dr-secrets/tls/hospital-web.key
REQUIRE_PRODUCTION_TLS=true

# MySQL Native Replication. NR is opt-in; Position is the project default.
DB_NR_ENABLED=false
DB_REPL_MODE=position
DB_SOURCE_HOST=
DB_SOURCE_PORT=3306
DB_SOURCE_LOG_FILE=
DB_SOURCE_LOG_POS=
DB_REPL_USER=repl1
