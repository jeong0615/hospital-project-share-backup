[Unit]
Description=Hospital DR ChatOps Cloudflare Tunnel
Requires=hospital-dr-chatops.service
After=hospital-dr-chatops.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloud
LoadCredential=chatops-tunnel.token:/etc/cloudflared/chatops-tunnel.token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file ${CREDENTIALS_DIRECTORY}/chatops-tunnel.token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
